{
  "name": "ng-smart-table-workspace",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build:demo": "ng build demo --configuration production",
    "build:lib": "ng build ng2-smart-table",
    "build:ci": "npm run build:lib && npm run build:demo && npm run test:ci",
    "docs:gh-pages": "npm run build:demo -- --base-href '/ng-smart-table/' && npx angular-cli-ghpages --dir=dist/demo",
    "test": "ng test ng2-smart-table",
    "test:ci": "ng test ng2-smart-table --no-watch",
    "test:coverage": "ng test ng2-smart-table --no-watch --coverage",
    "test:demo": "ng test demo --no-watch",
    "lint": "ng lint",
    "pack:lib": "npm run build:lib && bash scripts/patch-fesm-change-detection.sh && mkdir -p dist-pack && npm pack ./dist/ng2-smart-table --pack-destination dist-pack",
    "consumer:smoke": "bash scripts/consumer-smoke.sh",
    "consumer:smoke:ng18": "bash scripts/consumer-smoke-ng18.sh",
    "consumer:smoke:all": "npm run consumer:smoke && npm run consumer:smoke:ng18",
    "release": "npm run build:lib && bash scripts/patch-fesm-change-detection.sh && npm run publish:dist",
    "publish:dist": "npm publish --access=public ./dist/ng2-smart-table",
    "publish:beta": "bash scripts/publish-beta.sh",
    "audit:pack": "bash scripts/audit-pack.sh",
    "changelog": "standard-changelog -p angular"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@eslint/js": "^9.39.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.37.0",
    "highlight.js": "^11.10.0",
    "jsdom": "^29.1.1",
    "lodash-es": "^4.17.21",
    "ng-packagr": "^22.0.1",
    "rxjs": "~7.8.1",
    "standard-changelog": "^8.1.0",
    "tslib": "^2.6.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.8",
    "zone.js": "~0.15.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
